# ============================================================
# PORTFOLIO BACKEND ENVIRONMENT VARIABLES (EXAMPLE TEMPLATE)
# Copy this file to '.env.local' for local testing with Vercel CLI.
# Add these same variables to your Vercel Project Settings when deploying.
# NEVER commit your real '.env.local' or paste secrets in public code!
# ============================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Secret Key (starts with sb_secret_... - NEVER expose in frontend!)
# Found in: Supabase Dashboard -> Project Settings -> API Keys -> secret (or service_role)
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key_here

# Resend API Key (starts with re_)
# Found in: Resend Dashboard -> API Keys -> Create API Key
RESEND_API_KEY=re_your_resend_api_key_here

# Your inbox email address where you want to receive contact notifications
NOTIFICATION_EMAIL=atharvhadpe18@gmail.com